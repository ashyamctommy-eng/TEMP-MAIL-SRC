# ---- server ----
PORT=3000
HOST=0.0.0.0
SITE_URL=https://mail.example.com
TRUST_PROXY=1
SECURE_COOKIES=1

# ---- data ----
DATA_DIR=./data
# DB_PATH=./data/goldenmail.db

# ---- inbound SMTP ----
SMTP_ENABLED=1
SMTP_PORT=25
SMTP_HOST=0.0.0.0
SMTP_MAX_MB=25
MAX_ATTACHMENT_MB=10

# ---- admin bootstrap (used only on first run) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
SESSION_HOURS=12

# ---- mail identity ----
MAIL_HOSTNAME=mail.example.com
DEFAULT_DOMAIN=example.com

# ---- HTTP ingest secret (auto-generated if empty) ----
# INGEST_SECRET=

# ---- optional STARTTLS ----
# TLS_KEY_PATH=/etc/letsencrypt/live/mail.example.com/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/mail.example.com/fullchain.pem
